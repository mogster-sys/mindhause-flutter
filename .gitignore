# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Godot binary assets (tracked via Git LFS or downloaded separately)
godot_palace/models/**/*.glb
godot_palace/models/**/*.gltf
godot_palace/models/**/*.blend
godot_palace/audio/**/*.ogg
godot_palace/audio/**/*.wav
godot_palace/audio/**/*.mp3

# Godot import cache (regenerated by editor)
godot_palace/.godot/

# Keep texture sheets (small PNGs checked in) but ignore large split textures
godot_palace/textures/greco_roman/*.png
godot_palace/textures/modern_loft/*.png
godot_palace/textures/victorian/*.png
godot_palace/textures/scifi/*.png
godot_palace/textures/gothic/*.png
godot_palace/textures/ryokan/*.png
godot_palace/textures/cottage/*.png
godot_palace/textures/fallout/*.png

app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Godot binary assets (large models tracked separately)
godot_palace/models/**/*.blend

# Godot import cache (regenerated by editor)
godot_palace/.godot/

# Vendor assets — fetched via tools/fetch_free_assets.sh, not committed
godot_palace/assets/materials/polyhaven/
godot_palace/assets/materials/ambientcg/
godot_palace/assets/models/quaternius/
godot_palace/assets/models/kenney/
godot_palace/assets/models/plants/
godot_palace/assets/_staging/

# Sonniss GDC bundle — large WAV library (~30 GB extracted), source for SFX picks
godot_palace/audio/sonniss/
